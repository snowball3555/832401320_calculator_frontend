{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "name": "832401320-calculator-frontend",
  "version": 2,
  "public": true,
  "cleanUrls": true,
  "headers": [
    {
      "source": "/js/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=300" }]
    },
    {
      "source": "/css/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=300" }]
    }
  ],
  "rewrites": [{ "source": "/(.*)", "destination": "/index.html" }]
}
